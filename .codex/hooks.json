{
  "description": "Auto-update graphify knowledge graph after file changes",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|run_command|file_edit|file_write",
        "hooks": [
          {
            "type": "command",
            "command": "./.agents/scripts/update-graphify.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
