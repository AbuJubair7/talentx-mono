# Base URL of the TalentX backend API (includes the version segment).
# The backend's CORS policy only allows http://localhost:3000, so run this
# frontend on port 3000 (the Next.js dev default) for local development.
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_URL=http://localhost:5035/api/v1

# Frontend web application base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth 2.0 Web Client ID for Google Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
