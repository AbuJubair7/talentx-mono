# ==============================================================================
# TalentX Frontend Environment Configuration Template
# ==============================================================================
# This template is used by DevOps, QA, and Developers to configure the Next.js
# frontend environment for local development, staging, or production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Hosting & Port Configuration
# ------------------------------------------------------------------------------
# Port for the Next.js Node server to listen on (Default: 3000)
PORT=3000

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Public Frontend Origin (CORS & SEO Alignment)
# ------------------------------------------------------------------------------
# The fully-qualified public URL of this frontend application.
# Used for canonical links, OAuth redirects, and metadata.
# 
# ⚠️ DEVOPS NOTE: This exact origin MUST be listed in the backend's
# CORS_ALLOWED_ORIGINS environment variable, otherwise API requests will fail with CORS errors.
#
# Examples:
#   - Local Dev:   http://localhost:3000
#   - Staging:     https://staging.talentx.ai
#   - Production:  https://talentx.ai or https://app.talentx.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Backend API Gateway URL
# ------------------------------------------------------------------------------
# The base URL of the TalentX ASP.NET Core backend API (includes /api/v1).
#
# Examples:
#   - Local Dev:   http://localhost:5035/api/v1
#   - Staging:     https://staging-api.talentx.ai/api/v1
#   - Production:  https://api.talentx.ai/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5035/api/v1

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 Client Configuration
# ------------------------------------------------------------------------------
# Public Google Client ID obtained from Google Cloud Console (APIs & Services > Credentials).
# ⚠️ DEVOPS NOTE: Must match the GOOGLE_CLIENT_ID configured on the backend.
# In Google Cloud Console, add NEXT_PUBLIC_APP_URL to "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
